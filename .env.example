# Copy to .env (never commit .env — Phase 6 D133)
POSTGRES_PASSWORD=change-me
OPENROUTER_API_KEY=
# Password of the limited database role of the ui screens: make a long random one, then set it in the database too
# (infra/postgres/ui_role.sql). The ui service refuses to start without it.
UI_DB_PASSWORD=
# 1 opens the token-protected /dev/tools endpoints of the gateway (off by default)
DEV_TOOLS=0
# Passwords of the database owners (the gateway DB and the backend DB). Generate long random ones; apply them with
# infra/postgres/set_passwords.sql. docker compose refuses to start without them (no defaults).
GATEWAY_DB_PASSWORD=
NOVACART_DB_PASSWORD=
# Phone numbers that the static fallback text gives a user when a handoff could not be recorded (no document has them;
# leave empty and the text simply leaves the number out)
CS_PHONE=
EMERGENCY_PHONE=
DISPATCH_PHONE=
